# Dolos v2 container .dockerignore
# Build context: Payload_Type/dolos/ → InstalledServices/dolos/
#
# Agent code is COPY'd into /Mythic/ so the image works without a bind mount.
# Flat-file configs (00_*.json, 00_*.py, etc.) are also COPY'd.
# Only dev/test/local files are excluded.

# Python bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Git
.git/
.gitignore

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Venv
.venv/

# Local-only config (mythic-cli generates this from env vars, not needed in image)
rabbitmq_config.json
rabbitmq_config.local.json

# Dev docs not needed in container
*.md